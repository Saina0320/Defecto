# Copy this file to .env and fill in the values. Never commit .env.
#
# Both connection strings come from the Supabase dashboard: Connect > ORMs > Prisma.
# [USER] is "postgres", or "prisma" if you created the dedicated role described in the README.

# Used by the application (lib/prisma.ts).
# Transaction pooler, port 6543. It suits serverless and long-running servers alike.
DATABASE_URL="postgresql://[USER].[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Used by the Prisma CLI only (prisma.config.ts): db push, db pull, studio.
# Session pooler, port 5432. Schema changes do not work through the transaction pooler.
DIRECT_URL="postgresql://[USER].[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Used by lib/supabaseStorage.ts, server-only, to read/write the private "defect-evidence"
# Storage bucket. Both come from the Supabase dashboard: Settings > Data API (Project URL) and
# Settings > API Keys (service_role, under "Legacy API Keys" / "Secret keys").
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security, the same way Prisma's database role
# already does for Postgres (see prisma/sql/post-db-push.sql). It must NEVER be prefixed with
# NEXT_PUBLIC_ and must never be imported from a Client Component.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE-ROLE-KEY]"
